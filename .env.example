# Set real values in your untracked .env file or hosting-provider secret settings.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
VERIFICATION_CODE_SECRET=replace-with-a-separate-long-random-secret

# Optional one-time bootstrap for a new database only; uncomment and replace all values.
# ADMIN_NAME=System Administrator
# ADMIN_EMAIL=your-admin@my.cspc.edu.ph
# ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Gmail account with 2-Step Verification and a generated App Password.
# Do not use the normal Gmail account password and do not commit real values.
GMAIL_USER=your-dedicated-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
